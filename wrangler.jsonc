{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nexty325-tts",
  "account_id": "26efaeb7547838ae99622136a4cb0b12",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nexty325-tts"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "mangatranslator"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "R2_ACCOUNT_ID": "26efaeb7547838ae99622136a4cb0b12",
    "R2_BUCKET_NAME": "mangatranslator",
    "R2_PUBLIC_URL": "https://r2.mangatranslators.com"
  }
}
